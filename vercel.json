{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "app/**|static/**|training/ablation_results.json",
      "excludeFiles": "tests/**|*.md|dataset/**|training/dataset/**|*.wav|*.mp3"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
